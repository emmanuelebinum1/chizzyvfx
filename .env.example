# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# The email address where Chizzy / the team receives booking & guide notifications
OWNER_NOTIFICATION_EMAIL=your_email@gmail.com

# The verified sender email address in Resend (default for sandbox testing is onboarding@resend.dev)
# Once you verify your domain on Resend (e.g. chizzyvfx.com), set to: Chizzy VFX <calls@chizzyvfx.com>
SENDER_EMAIL=Chizzy VFX <onboarding@resend.dev>

# Google Docs link sent to visitors who request the free in-house guide
GUIDE_DOC_URL=https://docs.google.com/document/d/your-google-doc-id/edit?usp=sharing
